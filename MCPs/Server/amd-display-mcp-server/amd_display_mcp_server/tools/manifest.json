                        "default": 0,
                        "minimum": 0
                    }
                }
            }
        },
        {
            "tool": "tool_display_vsr",
            "name": "set_display_vsr_state",
            "description": "Call this tool to set the state of Virtual Super Resolution (VSR) for a display",
            "inputSchema": {
                "type": "object",
                "required": ["state"],
                "properties": {
                    "state": {
                        "type": "integer",
                        "description": "State to set for Virtual Super Resolution (VSR) - 0 for Off, 1 for On",
