{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "3D Settings: Debug (stdio)",
            "type": "debugpy",
            "request": "launch",
            "module": "amd_3dsettings_mcp_server",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/amd-3dsettings-mcp-server",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "args": [
                "--enable_log"
            ],
            "justMyCode": false
        },
        {
            "name": "3D Settings: Debug (streamable_http)",
            "type": "debugpy",
            "request": "launch",
            "module": "amd_3dsettings_mcp_server",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/amd-3dsettings-mcp-server",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "args": [
                "--enable_log",
                "--transport",
                "streamable_http"
            ],
            "justMyCode": false
        },
